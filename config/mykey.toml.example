# Top-level options:
#   memory_backend = "file"   # "file" (legacy full-text) or "erme" (semantic memory engine)

[sessions.default]
session_type = "claude"
api_key = "${ANTHROPIC_API_KEY}"
model = "claude-sonnet-4-20250514"
base_url = "https://api.anthropic.com"

